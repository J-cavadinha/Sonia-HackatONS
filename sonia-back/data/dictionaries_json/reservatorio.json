{
  "dataset_slug": "reservatorio",
  "source_pdf": "dataset/reservatorio/DicionarioDados_Reservatorio.pdf",
  "title": "DADOS DE RESERVATÓRIO",
  "description": "Dados cadastrais de reservatórios.",
  "fields": [
    {
      "label": "Nome do Reservatório",
      "code": "nom_reservatorio",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "20 POSIÇÕES",
      "nullable": false,
      "max_length": 20
    },
    {
      "label": "Tipo de Reservatório",
      "code": "tip_reservatorio",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "40 POSIÇÕES",
      "nullable": false,
      "max_length": 40
    },
    {
      "label": "Código do Reservatório nos Modelos de Planejamento",
      "code": "cod_resplanejamento",
      "data_type": "INTEGER",
      "raw_tipo": "INTEIRO",
      "nullable": true,
      "zero_allowed": false,
      "negative_allowed": false
    },
    {
      "label": "Posto de Vazão da Usina",
      "code": "cod_posto",
      "data_type": "INTEGER",
      "raw_tipo": "INTEIRO",
      "nullable": true,
      "zero_allowed": false,
      "negative_allowed": false
    },
    {
      "label": "Nome da Usina",
      "code": "nom_usina",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "60 POSIÇÕES",
      "nullable": false,
      "max_length": 60
    },
    {
      "label": "Código Único do Empreendimento de Geração (CEG), estabelecido pela ANEEL",
      "code": "ceg",
      "data_type": "STRING",
