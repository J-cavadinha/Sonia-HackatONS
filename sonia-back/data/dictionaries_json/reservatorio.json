      "code": "id_subsistema",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "2 POSIÇÕES",
      "nullable": false,
      "max_length": 2
    },
    {
      "label": "Nome do Subsistema",
      "code": "nom_subsistema",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "20 POSIÇÕES",
      "nullable": false,
      "max_length": 20
    },
    {
      "label": "Nome da Bacia Hidro-Energética",
      "code": "nom_bacia",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "15 POSIÇÕES",
      "nullable": false,
      "max_length": 15
    },
    {
      "label": "Nome do Rio",
      "code": "nom_rio",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "15 POSIÇÕES",
      "nullable": true,
      "max_length": 15
    },
    {
      "label": "Nome do Reservatório Equivalente",
      "code": "nom_ree",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "20 POSIÇÕES",
      "nullable": true,
      "max_length": 20
    },
    {
      "label": "Data de Entrada em Operação",
      "code": "dat_entrada",
      "data_type": "DATE",
      "raw_tipo": "DATE",
      "format": "YYYY-MM-DD",
      "nullable": false
    },
    {
      "label": "Cota Máxima Para Operação. Altura máxima do nível d'água de um reservatório, considerado para fins de operação normal medido em metros(m)",
      "code": "val_cotamaxima",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Cota Mínima Para Operação. Altura mínima do nível d'água de um reservatório considerado para fins de operação normal medido em metros(m).",
      "code": "val_cotaminima",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Volume Máximo. Volume do reservatório correspondente ao nível máximo operativo medido em hectômetro cúbico (hm3)",
      "code": "val_volmax",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Volume Mínimo. Volume do reservatório correspondente ao nível mínimo operativo medido em hectômetro cúbico (hm3)",
      "code": "val_volmin",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Volume Útil Total. Volume do reservatório compreendido entre o nível máximo de operação e mínimo normal de operação medido em hectômetro cúbico (hm3)",
      "code": "val_volutiltot",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Produtividade Específica, que indica quantos MW serão ganhos pela altura da queda",
      "code": "val_produtibilidadeespecifica",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Produtividade a 65% do volume útil medido em %",
      "code": "val_produtividade65volutil",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Tipo da Perda de Carga. Indica se o tipo de perda de carga está em porcentagem (%) ou Metros(m).",
      "code": "val_tipoperda",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "1 POSIÇÕES",
      "nullable": false,
      "max_length": 1
    },
    {
      "label": "Valor da perda de carga. Estes valores são os mesmos utilizados pelo programa Newave.",
      "code": "val_perda",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": true,
      "negative_allowed": false
    },
    {
      "label": "Latitude do Reservatório",
      "code": "val_latitude",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": true,
      "zero_allowed": false,
      "negative_allowed": true
    },
    {
      "label": "Longitude do Reservatório",
      "code": "val_longitude",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": true,
      "zero_allowed": false,
      "negative_allowed": true
    },
    {
      "label": "Identificador do Reservatório",
      "code": "id_reservatorio",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "6 POSIÇÕES",
      "nullable": false,
      "max_length": 6
    }
  ],
