      "raw_tipo": "TEXTO",
      "format": "1 POSIÇÕES",
      "nullable": false,
      "max_length": 1
    },
    {
      "label": "Indica se houve envolvimento de equipamentos da Rede de Operação do ONS na perturbação. O conteúdo é S (Sim) ou N (Não)",
      "code": "flg_envolveuredeoperacao",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "1 POSIÇÕES",
      "nullable": false,
      "max_length": 1
    }
