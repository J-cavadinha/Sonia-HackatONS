{
  "dataset_slug": "interrupcao_carga",
  "source_pdf": "dataset/interrupcao_carga/DicionarioDados_InterrupcaoDadosl.pdf",
  "title": "DADOS DE INTERRUPÇÃO DE CARGA",
  "description": "Dados de interrupção de carga relacionados a desligamentos forçados em equipamentos da Rede de Operação do ONS ou de desligamentos envolvendo apenas a Rede de Distribuição, quando maiores que 100 MW por 10 minutos ou mais. Os critérios de apuração dos dados são estabelecidos na RO-AO.BR.03 - Consistência dos Dados de Perturbações, disponível no MPO. Os dados são submetidos para consistência dos agentes e podem ser revisados.",
  "fields": [
    {
      "label": "Identificador da perturbação no Sistema Integrado de Perturbações (SIPER)",
      "code": "cod_perturbacao",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "12 POSIÇÕES",
      "nullable": false,
      "max_length": 12
    },
    {
      "label": "Instante da interrupção de carga",
      "code": "din_interrupcaocarga",
      "data_type": "DATETIME",
      "raw_tipo": "DATETIME",
      "format": "HH:MM",
      "nullable": false
    },
    {
      "label": "Sigla do subsistema",
      "code": "id_subsistema",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "2 POSIÇÕES",
      "nullable": false,
      "max_length": 2
    },
    {
      "label": "Nome do subsistema",
      "code": "nom_subsistema",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "60 POSIÇÕES",
      "nullable": false,
      "max_length": 60
    },
    {
      "label": "Sigla do estado",
      "code": "id_estado",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "2 POSIÇÕES",
      "nullable": false,
      "max_length": 2
    },
    {
      "label": "Nome do agente afetado pela interrupção de carga",
      "code": "nom_agente",
      "data_type": "STRING",
      "raw_tipo": "TEXTO",
      "format": "30 POSIÇÕES",
      "nullable": false,
      "max_length": 30
    },
    {
      "label": "Valor da interrupção de carga, em MW",
      "code": "val_cargainterrompida_mw",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": false,
      "negative_allowed": false
    },
    {
      "label": "Tempo médio para recompor a carga, em minutos",
      "code": "val_tempomedio_minutos",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": false,
      "negative_allowed": false
    },
    {
      "label": "Valor da energia não suprida na perturbação, em MWh",
      "code": "val_energianaosuprida_mwh",
      "data_type": "FLOAT",
      "raw_tipo": "FLOAT",
      "nullable": false,
      "zero_allowed": false,
      "negative_allowed": false
    },
    {
      "label": "Indica se houve envolvimento de equipamentos da Rede Básica na perturbação. O conteúdo é S (Sim) ou N (Não)",
